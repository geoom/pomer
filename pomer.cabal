cabal-version: 3.0
name: pomer
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Pomer.Timer
  hs-source-dirs: src
  build-depends:
    base >= 4.20 && < 4.21,
    time >= 1.12 && < 1.13
  default-language: Haskell2010

executable pomer
  main-is: Main.hs
  hs-source-dirs: .
  build-depends:
    base >= 4.20 && < 4.21,
    pomer
  default-language: Haskell2010

test-suite pomer-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
    base >= 4.20 && < 4.21,
    pomer,
    time >= 1.12 && < 1.13
  default-language: Haskell2010
